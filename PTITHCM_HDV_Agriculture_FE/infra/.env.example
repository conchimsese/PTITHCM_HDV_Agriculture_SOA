# Copy to .env and customize passwords/keys as needed.
# Note: user-service requires OTP_HMAC_SECRET >= 32 bytes and all INTERNAL_*_KEY values distinct and >= 32 bytes.

JWT_KEY_ID=local-2026-10-18
OTP_HMAC_SECRET=replace-with-otp-hmac-secret-at-least-32-bytes

USER_DB_PASSWORD=replace-user-db-password
FARMING_DB_PASSWORD=replace-farming-db-password
TRADING_DB_PASSWORD=replace-trading-db-password
PAYMENT_DB_PASSWORD=replace-payment-db-password
NOTIFICATION_DB_PASSWORD=replace-notification-db-password

INTERNAL_GATEWAY_KEY=replace-distinct-gateway-key-at-least-32-bytes
INTERNAL_FARMING_KEY=replace-distinct-farming-key-at-least-32-bytes
INTERNAL_TRADING_KEY=replace-distinct-trading-key-at-least-32-bytes
INTERNAL_CHAT_KEY=replace-distinct-chat-key-at-least-32-bytes-len
INTERNAL_PAYMENT_KEY=replace-distinct-payment-key-at-least-32-bytes
INTERNAL_NOTIFICATION_KEY=replace-distinct-notification-key-32-bytes-len

SERVICE_KEY_TRADING_TO_FARMING=replace-trading-to-farming-key-32-bytes-len
SERVICE_KEY_PAYMENT_TO_TRADING=replace-payment-to-trading-key-32-bytes-len

PUBLIC_APP_ORIGIN=http://localhost:5173
JWT_PUBLIC_KEYS_JSON={"local-2026-10-18":"-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PUBLIC_KEY\n-----END PUBLIC KEY-----\n"}
