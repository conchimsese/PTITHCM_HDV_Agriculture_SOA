{
  "name": "agriculture-frontend-standard",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @agri/web",
    "dev:mobile": "npm run start -w @agri/mobile",
    "dev:android": "npm run android -w @agri/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build:web": "npm run build -w @agri/web",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:web",
    "export:android": "npm run export:android -w @agri/mobile"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
