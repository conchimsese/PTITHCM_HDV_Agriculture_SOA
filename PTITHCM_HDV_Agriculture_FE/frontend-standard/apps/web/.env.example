VITE_GATEWAY_URL=http://localhost:8080
# Google OAuth Web Client ID (public). Never put a client secret in VITE_*.
VITE_GOOGLE_CLIENT_ID=
# Backend endpoint to verify { credential: Google ID token } and return TokenPair.
# Must be a public Gateway path starting with /api/v1/. Not present in current contract.
VITE_GOOGLE_LOGIN_PATH=
