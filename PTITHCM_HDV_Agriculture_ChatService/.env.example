SPRING_PROFILES_ACTIVE=learning,database-learning
MONGODB_URI=mongodb://localhost:27018/chat_db?replicaSet=rs0&directConnection=true
MEDIA_STORAGE_DIR=.media
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CHAT_OUTBOX_RELAY_ENABLED=true
CHAT_CONTRACT_CONSUMER_ENABLED=false
CHAT_OFFER_CONSUMER_ENABLED=false
CHAT_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
