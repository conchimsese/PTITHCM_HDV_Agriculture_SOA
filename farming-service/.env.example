# ==========================================
# FARMING SERVICE ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
SERVER_PORT=8082
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/farming_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farming_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Inter-Service Authentication & Security (User Service)
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=urn:soa:user-service
JWT_AUDIENCE=soa-api
USER_SERVICE_URL=http://localhost:8081
ACCESS_STATE_TIMEOUT_MS=1000

# Trading Service Internal Authentication
TRADING_SERVICE_KEY=trading-farming-internal-secret-key
